# Anthropic API key (Console). Used for unattended runs with the playwright driver.
ANTHROPIC_API_KEY=

# GitHub token with read access to the target repos (Phase 0: fine-grained PAT; later: GitHub App).
GITHUB_TOKEN=

# Credentials for target-app roles are referenced from claudio.config.json via env var names, e.g.:
# CLAUDIO_ROLE_ADMIN_USER=
# CLAUDIO_ROLE_ADMIN_PASSWORD=
