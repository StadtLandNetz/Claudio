# Anthropic API key for the CLI only. The web UI and worker never use it: every repository
# carries its own key (Repo → Einstellungen → Anthropic-API-Key), and runs without one do not start.
ANTHROPIC_API_KEY=

# GitHub token with read access to the target repos. Only the CLI uses it;
# the web UI uses the token of the person who starts a review.
GITHUB_TOKEN=
# The same for GitLab (claudio review --provider gitlab): a personal access token with scope "api".
# GITLAB_TOKEN=

# Credentials for target-app roles are referenced from claudio.config.json via env var names (CLI only), e.g.:
# CLAUDIO_ROLE_ADMIN_USER=
# CLAUDIO_ROLE_ADMIN_PASSWORD=

# ---- Web UI and worker

# MySQL (docker compose up -d starts one on port 3310)
DATABASE_URL=mysql://claudio:claudio@127.0.0.1:3310/claudio

# Encrypts GitHub/GitLab tokens and role credentials in the database. Generate with: openssl rand -base64 32
# Changing it makes stored credentials unreadable.
CLAUDIO_SECRET_KEY=

# Address the web UI is reached at (used for the OAuth callback)
PUBLIC_BASE_URL=http://localhost:5173

# GitHub OAuth App: Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Claudio as a GitHub App ("Claudio[bot]"), so comments, reviews, commit statuses and issues
# do not depend on one person's token. Create the app under Settings → Developer settings → GitHub Apps:
#   Permissions: Contents read, Metadata read, Pull requests write, Issues write, Commit statuses write, Deployments read
#   Events (if you use the app's webhook instead of per-repo webhooks): Issue comment, Pull request, Push, Deployment status
#   Webhook URL: <PUBLIC_BASE_URL>/webhooks/github
# Then install it on the repositories. The private key may be given with \n for line breaks.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=claudio
# GITHUB_APP_WEBHOOK_SECRET=

# ---- GitLab (optional; can run next to GitHub)

# The instance: https://gitlab.com (default) or your self-managed GitLab
# GITLAB_URL=https://gitlab.com

# GitLab OAuth application: User settings → Applications (or a group's / the instance's applications)
#   Redirect URI:  http://localhost:5173/auth/gitlab/callback
#   Confidential:  yes
#   Scopes:        api  (comments, commit statuses, issues and webhooks need write access)
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# Optional: Claudio's own GitLab user ("bot"), so comments, reviews, commit statuses and issues
# do not depend on one person's token. Create a dedicated user, invite it as Developer to the projects,
# and give it a personal access token with scope "api" (it expires after at most a year; the
# repository settings show when). Without it, Claudio writes with the token of a person.
# GITLAB_BOT_TOKEN=

# Optional: how long a question of the agent waits for an answer (minutes, default 20)
# CLAUDIO_QUESTION_TIMEOUT_MIN=20

# Optional: who may sign in (comma-separated). Without any list, everybody may sign in.
# With lists for one provider only, the other provider lets nobody in.
CLAUDIO_ALLOWED_GITHUB_ORGS=
CLAUDIO_ALLOWED_GITHUB_USERS=
# GitLab: group paths (members of subgroups count for the group above) and user names
# CLAUDIO_ALLOWED_GITLAB_GROUPS=
# CLAUDIO_ALLOWED_GITLAB_USERS=

# Optional: worker settings
# CLAUDIO_WORKER_CONCURRENCY=1
# CLAUDIO_RUNS_DIR=runs

# Development only: demo repository with the fixture PR from apps/demo-target and a login without GitHub
# CLAUDIO_DEV_FIXTURES=1
