# Anthropic API key (Console). Used for unattended runs with the playwright driver.
# Without it, the Agent SDK falls back to the Claude Code login on this machine.
ANTHROPIC_API_KEY=

# GitHub token with read access to the target repos. Only the CLI uses it;
# the web UI uses the token of the person who starts a review.
GITHUB_TOKEN=

# Credentials for target-app roles are referenced from claudio.config.json via env var names (CLI only), e.g.:
# CLAUDIO_ROLE_ADMIN_USER=
# CLAUDIO_ROLE_ADMIN_PASSWORD=

# ---- Web UI and worker

# MySQL (docker compose up -d starts one on port 3310)
DATABASE_URL=mysql://claudio:claudio@127.0.0.1:3310/claudio

# Encrypts GitHub tokens and role credentials in the database. Generate with: openssl rand -base64 32
# Changing it makes stored credentials unreadable.
CLAUDIO_SECRET_KEY=

# Address the web UI is reached at (used for the OAuth callback)
PUBLIC_BASE_URL=http://localhost:5173

# GitHub OAuth App: Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: who may sign in (comma-separated). Empty = every GitHub user.
CLAUDIO_ALLOWED_GITHUB_ORGS=
CLAUDIO_ALLOWED_GITHUB_USERS=

# Optional: worker settings
# CLAUDIO_WORKER_CONCURRENCY=1
# CLAUDIO_RUNS_DIR=runs

# Development only: demo repository with the fixture PR from apps/demo-target and a login without GitHub
# CLAUDIO_DEV_FIXTURES=1
