  "en:repo.dataConfirmed": "The instances under test contain only test data.",
  "en:repo.dataConfirmedHint": "Screenshots and page content are sent to Anthropic. Without this confirmation Claudio starts no review.",
  "en:repo.defaultUrl": "Default instance URL",
