  "en:landing.ctaDemo": "Try the demo",
  "en:landing.ctaDemoHint": "No account needed, with a ready-made example.",
  "en:landing.ctaDemoLocal": "Run the demo locally",
  "en:landing.ctaDemoLocalHint": "The demo runs on your machine, without an account and with a ready-made example.",
  "en:landing.ctaHow": "How it works",
  "en:landing.ctaLead": "Sign in and set up your repository. Or try the demo first: a small dispatch app with built-in bugs for Claudio to find.",
  "en:landing.ctaSelfHost": "Host it yourself",
  "en:landing.ctaTitle": "Let Claudio check your next pull request.",
  "en:landing.dismiss": "Dismiss",
  "en:landing.dismissed": "dismissed",
  "en:landing.enlarge": "Enlarge screenshot: X",
  "en:landing.expected": "Expected",
  "en:landing.factForgesBoth": "GitHub and GitLab",
  "en:landing.factLanguages": "German and English",
  "en:landing.factViewports": "Desktop and phone",
  "en:landing.findingActions": "Rating of X",
  "en:landing.globalChange": "Global change: it affects every page, so all tests run.",
  "en:landing.graphLabel": "Import graph of the example app",
  "en:landing.heroKicker": "AI acceptance testing for pull requests",
  "en:landing.heroLead": "Claudio reads the pull request and its ticket, clicks through the running preview the way a person would and writes a test report with evidence. You decide what counts.",
  "en:landing.heroLead1": "AI writes the code.",
  "en:landing.heroRest": "checks it",
  "en:landing.heroStampHint": "Click: who checks?",
  "en:landing.heroTitle": "AI writes the code. Claudio checks it.",
  "en:landing.heroWho": "Who",
  "en:landing.howKicker": "How it works",
  "en:landing.howLead": "Using the demo app as an example: a pull request adds a “New trip” form and a search to the trip list.",
  "en:landing.howTitle": "From pull request to verdict in five steps",
  "en:landing.humanText": "At a bot check Claudio stops and someone takes over the browser for a moment. Questions show up in the UI and in Slack.",
  "en:landing.humanTitle": "Asks instead of guessing",
  "en:landing.impactCaption": "Computed without a model: the import graph decides which tests run.",
  "en:landing.impactKicker": "Test selection",
  "en:landing.impactLead": "Click the files the pull request changes. Claudio follows the imports up to the pages and picks only the tests that go through them.",
  "en:landing.impactTitle": "What a change touches",
  "en:landing.inertChange": "Documentation changes nothing anyone sees. No test runs.",
  "en:landing.knowledgeText": "A repository analysis explores the app page by page and records modules, routes and expected behaviour. Every review starts from this knowledge.",
  "en:landing.knowledgeTitle": "Knowledge base",
  "en:landing.lessonNote": "Dismissing a finding with a reason teaches Claudio: later reviews no longer report it.",
  "en:landing.linkedIssue": "Linked issue",
  "en:landing.liveView": "Live view",
  "en:landing.markChanged": "Click to mark X as changed",
  "en:landing.metaDescription": "Claudio reads the pull request and its ticket, tests the running preview in a real browser and writes a test report with evidence.",
  "en:landing.moreKicker": "More than reviews",
  "en:landing.moreTitle": "Knows your app. Tests for next to nothing.",
  "en:landing.navHow": "How it works",
  "en:landing.navImpact": "Test selection",
  "en:landing.navSecurity": "Security",
  "en:landing.navVerdict": "Verdict",
  "en:landing.observed": "Observed",
  "en:landing.onThePr": "On the pull request",
  "en:landing.pageNav": "Page navigation",
  "en:landing.pageTitle": "Claudio · AI acceptance testing for pull requests",
  "en:landing.pause": "Pause",
  "en:landing.pickHint": "Pick one or more files.",
  "en:landing.plainTestsText": "Describe the flow and the expected result. The first run records it, after that the test runs without AI. When the UI changes, Claudio repairs the steps.",
  "en:landing.plainTestsTitle": "Tests in plain language",
  "en:landing.play": "Play",
  "en:landing.regressionTests": "Regression tests",
  "en:landing.reset": "Reset",
  "en:landing.reviewApproved": "recommends approval",
  "en:landing.reviewChanges": "requested changes",
  "en:landing.routeDirect": "changed directly",
  "en:landing.routeEndpoint": "Endpoint",
  "en:landing.routeLayout": "Layout, covers everything below",
  "en:landing.routeShared": "via shared code",
  "en:landing.sec1": "Credentials are stored encrypted and never reach the model. Claudio fills in the login itself.",
  "en:landing.sec2": "A host allowlist keeps the agent on your app.",
  "en:landing.sec3": "Claudio never solves a CAPTCHA itself.",
  "en:landing.sec4": "Each repository uses its own Anthropic key, with a budget cap per run and per month.",
  "en:landing.sec5": "Tests run only on instances with test data. Whatever Claudio creates is marked as such.",
  "en:landing.securityKicker": "Security",
  "en:landing.securityTitle": "You stay in control",
  "en:landing.selfDocs": "Deployment guide",
  "en:landing.selfRepoGithub": "Repository on GitHub",
  "en:landing.selfReqs": "Node 22, pnpm 10, MySQL 5.7 or 8",
  "en:landing.selfText": "One Docker image for web and worker, plus MySQL. Kubernetes manifests and a CI/CD pipeline are included.",
  "en:landing.selfTitle": "Host it yourself",
  "en:landing.signIn": "Sign in",
  "en:landing.stat1Label": "for 6 checked criteria, at a cost of 2.36 USD",
  "en:landing.stat1Value": "5 min 54 s",
  "en:landing.stat2Label": "with evidence, 5 of them block the approval",
  "en:landing.stat2Value": "10 findings",
  "en:landing.stat3Label": "to replay a test with 80 steps",
  "en:landing.stat3Value": "0.00 USD",
  "en:landing.statsSource": "Figures from a review of the demo app.",
  "en:landing.step1Text": "As soon as the preview is up, Claudio reads the diff, the description and the linked issues.",
  "en:landing.step1Title": "Read the pull request",
  "en:landing.step2Text": "The ticket becomes a list of testable acceptance criteria. You can edit the list before the run.",
  "en:landing.step2Title": "Derive criteria",
  "en:landing.step3Text": "The import graph shows which pages the change reaches and picks the regression tests that cover them.",
  "en:landing.step3Title": "Compute the impact",
  "en:landing.step4Text": "Claudio signs in as your role, clicks through and keeps screenshots, console and network logs.",
  "en:landing.step4Title": "Test in the browser",
  "en:landing.step5Text": "Every finding comes with steps, expected and observed behaviour. The verdict lands as a review on the pull request.",
  "en:landing.step5Title": "Report and verdict",
