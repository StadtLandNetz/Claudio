{
  "name": "claudio",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic user-review and frontend test suite built on the Claude Agent SDK",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "claudio": "tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
